# Connect a free Postgres database before enabling accounts.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Keep closed until the database and account isolation are verified.
ALLOW_SIGNUP=false

# Comma-separated invitations; registration rejects every address when empty.
PILOT_SIGNUP_EMAILS=

# Owner-scoped pilot automation; independent of browser sessions.
CAREER_AUTOMATION_TOKEN=
CAREER_AUTOMATION_EMAIL=

# Service-wide PDF budget: uploads and restores stop at this total (100 MiB).
TOTAL_DOCUMENT_BYTES=104857600

# Separate public-beta gate. Keep false until release checks pass.
PUBLIC_SIGNUP=false

# Daily company job board checks (vercel.json cron). Vercel sends it as a bearer token; at least 32 characters.
# Unset keeps /api/cron/discovery closed; manual "Check now" still works.
CRON_SECRET=

# Optional server error reporting (Sentry Developer plan is free). Unset disables reporting.
SENTRY_DSN=
